# ==============================================================================
# CrewConnect API — Environment Configuration Template
# Copy this file to .env for local development. Never commit sensitive secrets.
# ==============================================================================

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Replica Set URI
MONGODB_URI=mongodb://localhost:27017/crewconnect?replicaSet=rs0
MONGODB_DB_NAME=crewconnect

# Authentication
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars_long
JWT_EXPIRES_IN=1d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
