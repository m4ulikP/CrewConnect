# ==============================================================================
# CrewConnect - Environment Configuration Template
# Copy this file to .env or .env.local for local development.
# DO NOT COMMIT SENSITIVE VALUES OR PRODUCTION CREDENTIALS TO SOURCE CONTROL.
# ==============================================================================

# Node Environment ("development" | "test" | "production")
NODE_ENV=development
PORT=5000

# Client Configuration
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:5000

# Database Configuration (MongoDB Replica Set required for multi-document ACID transactions)
# Local Docker replica set: mongodb://localhost:27017/crewconnect?replicaSet=rs0
# Production MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/crewconnect?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/crewconnect?replicaSet=rs0
MONGODB_DB_NAME=crewconnect

# Authentication & Security
# In production (NODE_ENV=production), JWT_SECRET is strictly mandatory and cannot use the dev default.
# Generate in terminal: openssl rand -hex 32
JWT_SECRET=default_development_secret_key_that_is_at_least_32_characters_long!
JWT_EXPIRES_IN=1d

# Session / Cookie Security
# Set COOKIE_SECURE=true when serving over HTTPS in production.
# COOKIE_SAME_SITE: "lax" (same-domain/proxy), "strict" (high-security same-origin), or "none" (cross-origin HTTPS requires COOKIE_SECURE=true).
COOKIE_SECRET=replace_with_a_secure_cookie_secret_at_least_32_chars
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000      # 15 minutes window for general API endpoints
RATE_LIMIT_MAX_REQUESTS=100      # Max requests per window per IP
JOIN_RATE_LIMIT_WINDOW_MS=60000  # 1 minute window for seat reservation & invitations
JOIN_RATE_LIMIT_MAX_REQUESTS=10  # Max join/invite attempts per minute per user/IP

# Logging
LOG_LEVEL=info # debug, info, warn, error
