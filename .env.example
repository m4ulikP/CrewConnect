# ==============================================================================
# CrewConnect - Environment Configuration Template
# Copy this file to .env or .env.local for local development.
# DO NOT COMMIT SENSITIVE VALUES OR PRODUCTION CREDENTIALS TO SOURCE CONTROL.
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=5000

# Client Configuration
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:5000

# Database Configuration (MongoDB Replica Set required for multi-document transactions)
# Local development replica set URI (provided by Docker Compose in Phase 2)
MONGODB_URI=mongodb://localhost:27017/crewconnect?replicaSet=rs0
MONGODB_DB_NAME=crewconnect

# Authentication & Security
# Generate a strong random 256-bit key in production
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars_long
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=replace_with_a_different_secure_random_secret
REFRESH_TOKEN_EXPIRES_IN=7d

# Session / Cookie Security
COOKIE_SECRET=replace_with_a_cookie_signing_secret
COOKIE_SECURE=false # Set to true in production (HTTPS)
COOKIE_SAME_SITE=lax # lax or strict

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes in ms
RATE_LIMIT_MAX_REQUESTS=100  # Default general limit
JOIN_RATE_LIMIT_WINDOW_MS=60000 # 1 minute
JOIN_RATE_LIMIT_MAX_REQUESTS=10 # Sensitive endpoint limit

# Logging
LOG_LEVEL=info # debug, info, warn, error
